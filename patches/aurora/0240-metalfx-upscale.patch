+#ifndef AURORA_METALFX_H
+#define AURORA_METALFX_H
+// MetalFX spatial upscaling of the presented game image (Apple platforms, Metal backend).
+//
+// When on, the game frame (render resolution) is upscaled to the present viewport by Apple's
+// MTLFXSpatialScaler instead of Aurora's present resample. It needs the Dawn features
+// SharedTextureMemoryIOSurface and SharedFenceMTLSharedEvent (requested on Apple when the adapter
+// has them) and a device MetalFX supports. Whenever any of that is missing or a step fails, the
+// normal resample is used (logged once with the reason); never a black frame. It is idle while a
+// post-process chain (postfx.h) is active or the frame is not smaller than the viewport.
+#ifdef __cplusplus
+extern "C" {
+#else
+#include <stdbool.h>
+#endif
+
+// Any thread. Takes effect at the next present.
+void aurora_set_metalfx(bool enabled);
+// After aurora_initialize: whether MetalFX can run on this device (features, MetalFX support).
+bool aurora_metalfx_available(void);
+// Short state for logs, e.g. "active 1280x590 -> 2796x1290", "off", "unavailable: <reason>".
+const char* aurora_metalfx_status(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
