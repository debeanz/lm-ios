<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for signing the IPA (docs/IOS.md "Installing"). Sideloading tools that keep the
     app's entitlements (Sideloadly "advanced options", a paid developer account) grant the larger
     memory limit, which the 64 MiB guest memory window, the shader caches and high resolutions
     appreciate on 6 GB iPhones. Free accounts drop them; the game still runs. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
